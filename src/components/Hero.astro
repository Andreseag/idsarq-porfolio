---
import LogoSVG from "./LogoSVG.astro";
---

<section id="inicio" class="relative h-screen min-h-[700px] flex items-center justify-center overflow-hidden">
  <div
    id="hero-bg"
    class="absolute inset-0 bg-cover bg-center transition-transform duration-700 ease-out"
    style="background-image: url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1920&q=80'); transform: scale(1.1);"
  >
  </div>
  <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/70 via-brand-dark/50 to-brand-dark/90"></div>

  <div class="absolute top-20 left-10 w-px h-32 bg-gradient-to-b from-transparent via-brand-cream/30 to-transparent"></div>
  <div class="absolute bottom-20 right-10 w-px h-32 bg-gradient-to-b from-transparent via-brand-cream/30 to-transparent"></div>

  <div class="relative z-10 text-center px-6 max-w-5xl mx-auto" data-reveal>
    <div class="flex justify-center mb-8">
      <LogoSVG class="w-16 h-16 md:w-20 md:h-20" />
    </div>
    <h1 class="text-5xl md:text-7xl lg:text-8xl font-light text-brand-cream tracking-tight leading-none mb-6">
      Arquitectura que<br />
      <span class="font-semibold text-gradient">trasciende</span>
    </h1>
    <p class="text-lg md:text-xl text-brand-accent font-light max-w-2xl mx-auto mb-10 leading-relaxed">
      Diseñamos espacios que inspiran, conectan y perduran. Cada proyecto es una sinfonía de forma, luz y materia.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <button
        data-scroll-to="proyectos"
        class="group px-8 py-4 bg-brand-cream text-brand-dark font-medium rounded-lg hover:bg-brand-warm transition-all duration-300 hover:shadow-xl hover:shadow-brand-cream/20 cursor-pointer"
      >
        Ver proyectos
        <span class="inline-block ml-2 transition-transform group-hover:translate-x-1">→</span>
      </button>
      <button
        data-scroll-to="cotizacion"
        class="px-8 py-4 border border-brand-cream/30 text-brand-cream font-medium rounded-lg hover:bg-brand-cream/10 transition-all duration-300 backdrop-blur-sm cursor-pointer" 
      >
        Solicitar cotización
      </button>
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <div class="w-6 h-10 border-2 border-brand-cream/30 rounded-full flex justify-center pt-2">
      <div class="w-1 h-2 bg-brand-cream/60 rounded-full"></div>
    </div>
  </div>
</section>

<script>
  const heroBg = document.getElementById("hero-bg");
  if (heroBg) {
    window.addEventListener("mousemove", (e) => {
      const x = (e.clientX / window.innerWidth - 0.5) * 20 * 0.3;
      const y = (e.clientY / window.innerHeight - 0.5) * 20 * 0.3;
      heroBg.style.transform = `scale(1.1) translate(${x}px, ${y}px)`;
    });
  }

  document.querySelectorAll("[data-scroll-to]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = (btn as HTMLElement).dataset.scrollTo;
      if (!id) return;
      document.getElementById(id)?.scrollIntoView({ behavior: "smooth" });
    });
  });
</script>
